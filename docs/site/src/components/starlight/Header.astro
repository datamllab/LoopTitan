---
// The homepage's header: the lockup, the section links with the current one marked by a short bar under it,
// Docs as a nav item, and the ghost GitHub button; the search and the theme switch sit before the button.
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { markSvg } from '../../lib/mark.mjs';
import { sprite } from '../../lib/sprite.mjs';
import { BASE, REPO_URL } from '../../../nav.mjs';

const sections = [['designs', 'Designs'], ['compare', 'Compare'], ['check', 'Check'], ['studies', 'Studies'], ['record', 'Record'], ['start', 'Start']];
const gh = 'M8 .2a8 8 0 0 0-2.5 15.6c.4 0 .5-.2.5-.4v-1.5c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.3 1.9.9 2.4.7 0-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.5 7.5 0 0 1 4 0c1.5-1 2.2-.8 2.2-.8.5 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.7-3.6 3.9.3.3.6.8.6 1.5v2.2c0 .2.1.5.6.4A8 8 0 0 0 8 .2';
---

<Fragment set:html={sprite} />
<div class="lt-head">
	<a class="lt-lockup" href={BASE} aria-label="LoopTitan, home">
		<span class="lt-lockup__mark" set:html={markSvg} />
		<span class="lt-lockup__name">LoopTitan</span>
	</a>
	<nav class="lt-nav" aria-label="Site">
		{sections.map(([id, label]) => <a class="lt-nav__s" href={`${BASE}#${id}`}>{label}</a>)}
		<a class="lt-nav__docs is-here" href={`${BASE}docs/`} aria-current="page">Docs</a>
	</nav>
	<div class="lt-head__search"><Search /></div>
	<ThemeSelect />
	<a class="lt-btn lt-btn--ghost lt-btn--s lt-head__gh" href={REPO_URL} rel="noopener"
		><svg class="i" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={gh}></path></svg><span>GitHub</span></a
	>
</div>
