---
// Starlight's <head>, the shared tokens (the homepage's own file) and preloads for its two faces.
import Default from '@astrojs/starlight/components/Head.astro';
import { BASE } from '../../../nav.mjs';
---

<link rel="stylesheet" href={`${BASE}tokens.css`} />
<Default><slot /></Default>
<link rel="preload" href={`${BASE}fonts/inter.woff2`} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={`${BASE}fonts/geist-mono.woff2`} as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111317" media="(prefers-color-scheme: dark)" />
